# ================= 服务 =================
# H5 必须公网 HTTPS 访问，反向代理由 Nginx 负责，本服务只监听本机端口
PORT=3000
NODE_ENV=production
# 本应用在钉钉里的公网地址，必须与 Nginx 对外域名一致（jsapi 鉴权签名要用完整 URL）
PUBLIC_BASE_URL=https://payslip.yourdomain.com

# ================= 钉钉企业内部应用 =================
# 开发者后台 - 应用详情 - 凭证与基础信息
DING_CORP_ID=dingxxxxxxxxxxxxxxxx
DING_APP_KEY=dingxxxxxxxxxxxxxxxx
DING_APP_SECRET=请填应用的AppSecret
DING_AGENT_ID=1234567890
# H5 免登 jsapi 的 CDN 地址，若失效请到钉钉开放平台文档替换为最新版本号
DING_JSAPI_URL=https://g.alicdn.com/dingding/dingtalk-jsapi/3.0.25/dingtalk.open.js

# ================= 数据库 =================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=payslip
DB_PASSWORD=请填数据库密码
DB_NAME=payslip

# ================= 安全 =================
# 会话签名密钥，请改成一串随机长字符串（生成命令：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-hex-string
# 会话有效期（小时）
JWT_TTL_HOURS=12
# HR 管理员工号白名单（钉钉通讯录里的工号字段），逗号分隔
# 注意：实测有人把入职日期填进了钉钉工号字段，所以更可靠的做法是用下面的 userId 白名单
ADMIN_JOB_NUMBERS=1001,1002
# 管理员 userId 白名单（推荐，钉钉后台通讯录或 dws 可查），逗号分隔；与工号白名单满足其一即可
ADMIN_USER_IDS=
# 备用管理员口令（用于不在钉钉内的电脑浏览器上管理，生产环境建议留空禁用）
ADMIN_PASSWORD=

# ================= 调试 =================
# 1=开启本地调试登录（浏览器直接访问 /?debugUserId=xxx 可免钉钉登录）
# 上线前务必设回 0
DEV_MODE=0
